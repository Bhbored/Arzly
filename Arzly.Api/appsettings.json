{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [],
  "RateLimits": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Uploads": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Messaging": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Reports": { "PermitLimit": 10, "WindowSeconds": 300 },
    "Broadcasts": { "PermitLimit": 10, "WindowSeconds": 60 },
    "EmailDelivery": { "PermitLimit": 3, "WindowSeconds": 600 },
    "Credentials": { "PermitLimit": 10, "WindowSeconds": 600 },
    "Maps": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Support": { "PermitLimit": 20, "WindowSeconds": 300 },
    "Writes": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownIPNetworks": [],
    "ForwardLimit": 1
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Retention": {
    "SoftDeletedListingsDays": 30,
    "ScheduledPurgeEnabled": false,
    "PurgeIntervalHours": 24,
    "SystemActorId": ""
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "EXPIRATION_MINUTES": 60,
    "Key": ""
  },
  "RefreshToken": {
    "EXPIRATION_DAYS": 30
  },
  "CloudflareR2": {
    "SecretKey": "",
    "AccessKey": "",
    "ServiceURL": "",
    "BucketName": "",
    "PublicUrlBase": ""
  },
  "GoogleMaps": {
    "ApiKey": ""
  },
  "Email": {
    "Host": "",
    "Port": "587",
    "Username": "",
    "Password": "",
    "TimeoutMilliseconds": 15000
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "ApplicationName": "Arzly Api"
    }
  }
}
