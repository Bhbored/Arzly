<span class="@($"px-2 py-1 text-xs font-semibold rounded-full {ComputedClass} {Class}")">
    @ChildContent
</span>

@code {
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Variant { get; set; } = ""; // semantic variant: success, pending, error, info, sold, neutral
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string ComputedClass => (Variant ?? "").ToLowerInvariant() switch
    {
        "success" => "bg-forest/10 text-forest",
        "pending" => "bg-harvest/10 text-harvest",
        "error" => "bg-bark-red/10 text-bark-red",
        "info" => "bg-canopy-sky/10 text-canopy-sky",
        "sold" => "bg-primary-container/10 text-primary-container",
        "neutral" => "bg-surface-container-low text-stone",
        _ => string.Empty,
    };
}
