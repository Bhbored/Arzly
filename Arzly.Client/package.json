{
  "name": "arzly-client",
  "version": "1.0.0",
  "scripts": {
    "build:css": "tailwindcss -i ./wwwroot/css/app.css -o ./wwwroot/css/site.css --minify",
    "watch:css": "tailwindcss -i ./wwwroot/css/app.css -o ./wwwroot/css/site.css --watch",
    "build": "npm run build:css",
    "dev": "npm run watch:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1"
  }
}
