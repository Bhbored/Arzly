<div class="flex flex-col h-full bg-surface text-on-surface w-sidebar-expanded transition-all duration-300">
    <div class="flex items-center justify-between p-4 h-16 border-b border-outline-variant">
        <span class="text-xl font-bold tracking-tight text-primary">Arzly Admin</span>
        <button class="lg:hidden text-stone hover:text-on-surface" @onclick="ToggleSidebar">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <nav class="flex-1 overflow-y-auto py-4 custom-scrollbar">
        <div class="px-4 mb-2 text-xs font-semibold text-stone uppercase tracking-wider">
            Main
        </div>
        <div class="space-y-1 px-2">
            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200" href="" Match="NavLinkMatch.All" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard</span>
            </NavLink>

            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200" href="listings" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">list_alt</span>
                <span>Listings</span>
            </NavLink>

            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200" href="job-listings" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">work</span>
                <span>Job Listings</span>
            </NavLink>

            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200" href="categories" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">category</span>
                <span>Categories</span>
            </NavLink>

            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200" href="users" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">group</span>
                <span>Users</span>
            </NavLink>

            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200" href="chats" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">chat</span>
                <span>Chats</span>
            </NavLink>

            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200" href="support-tickets" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">confirmation_number</span>
                <span>Support Tickets</span>
            </NavLink>

            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200" href="user-reports" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">report</span>
                <span>User Reports</span>
            </NavLink>

            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200" href="notifications" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">notifications</span>
                <span>Notifications</span>
            </NavLink>

            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200" href="analytics" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">analytics</span>
                <span>Analytics</span>
            </NavLink>

            <NavLink class="flex items-center gap-3 px-4 py-3 border-l-4 border-transparent text-stone hover:text-primary transition-colors hover:bg-surface-container-low dark:hover:bg-surface-container-highest active:scale-[0.98] transition-all duration-200 mt-auto" href="settings" ActiveClass="border-primary bg-primary/5 text-primary font-body-lg">
                <span class="material-symbols-outlined">settings</span>
                <span>Settings</span>
            </NavLink>
        </div>
    </nav>

    <div class="p-4 border-t border-outline-variant">
        <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white font-bold">
                A
            </div>
            <div class="flex-1 overflow-hidden">
                <p class="text-sm font-medium truncate">Admin User</p>
                <p class="text-xs text-stone truncate">admin@arzly.com</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }

    private async Task ToggleSidebar()
    {
        await OnToggleSidebar.InvokeAsync();
    }
}
