<div class="flex flex-col h-full bg-slate-900 text-white w-[var(--sidebar-width)] transition-all duration-300">
    <div class="flex items-center justify-between p-4 h-16 border-b border-slate-800">
        <span class="text-xl font-bold tracking-tight text-primary">Arzly Admin</span>
        <button class="lg:hidden text-slate-400 hover:text-white" @onclick="ToggleSidebar">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <nav class="flex-1 overflow-y-auto py-4 custom-scrollbar">
        <div class="px-4 mb-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">
            Main
        </div>
        <div class="space-y-1 px-2">
            <NavLink class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-800 transition-colors" 
                     href="" Match="NavLinkMatch.All" ActiveClass="bg-primary text-white hover:bg-primary">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                Dashboard
            </NavLink>

            <NavLink class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-800 transition-colors" 
                     href="listings" ActiveClass="bg-primary text-white hover:bg-primary">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
                Listings
            </NavLink>

            <NavLink class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-800 transition-colors" 
                     href="job-listings" ActiveClass="bg-primary text-white hover:bg-primary">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                Job Listings
            </NavLink>

            <NavLink class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-800 transition-colors" 
                     href="categories" ActiveClass="bg-primary text-white hover:bg-primary">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                </svg>
                Categories
            </NavLink>

            <NavLink class="flex items-center px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-800 transition-colors" 
                     href="reports" ActiveClass="bg-primary text-white hover:bg-primary">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                Reports
            </NavLink>
        </div>
    </nav>

    <div class="p-4 border-t border-slate-800">
        <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white font-bold">
                A
            </div>
            <div class="flex-1 overflow-hidden">
                <p class="text-sm font-medium truncate">Admin User</p>
                <p class="text-xs text-slate-500 truncate">admin@arzly.com</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }

    private async Task ToggleSidebar()
    {
        await OnToggleSidebar.InvokeAsync();
    }
}
