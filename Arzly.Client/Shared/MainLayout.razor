@using Microsoft.AspNetCore.Components
@inherits LayoutComponentBase
@inject Arzly.Client.Services.RightSliderService SliderService

<div class="flex h-screen overflow-hidden bg-background text-on-background font-body-md text-body-md">
    <!-- Sidebar -->
    <aside class="@(isSidebarOpen ? "translate-x-0" : "-translate-x-full") lg:translate-x-0 fixed lg:static inset-y-0 left-0 z-50 flex-shrink-0 transition-transform duration-300 ease-in-out">
        <NavMenu OnToggleSidebar="ToggleSidebar" />
    </aside>

    <!-- Overlay -->
    @if (isSidebarOpen)
    {
        <div class="fixed inset-0 z-40 bg-black bg-opacity-50 lg:hidden" @onclick="ToggleSidebar"></div>
    }

    <!-- Main Content -->
    <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
        <!-- Top navigation (fixed) -->
        <TopNav />

        <!-- Main Area -->
        <main class="flex-1 overflow-y-auto custom-scrollbar bg-background p-container-padding lg:p-8">
            <div class="max-w-7xl mx-auto">
                @Body
            </div>
        </main>
    </div>

    @if (SliderService.IsOpen)
    {
        <!-- Right sliding panel -->
        <RightSlider IsOpen="@SliderService.IsOpen" IsOpenChanged="@(v => SliderService.SetIsOpen(v))" Title="@SliderService.Title">
            @if (SliderService.ComponentType is not null)
            {
                <DynamicComponent Type="@SliderService.ComponentType" Parameters="@SliderService.Parameters" />
            }
        </RightSlider>
    }

    <!-- Floating trigger button -->
    <button class="fixed bottom-6 right-6 z-50 bg-primary text-white p-3 rounded-full shadow-lg" @onclick="ToggleRightSlider" aria-label="Open side panel">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
    </button>

    <Toasts />
</div>

@code {
    private bool isSidebarOpen = false;

    protected override void OnInitialized()
    {
        SliderService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SliderService.OnChange -= StateHasChanged;
    }

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void ToggleRightSlider()
    {
        SliderService.SetIsOpen(!SliderService.IsOpen);
    }
}
