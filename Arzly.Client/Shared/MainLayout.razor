@inherits LayoutComponentBase

<div class="flex h-screen overflow-hidden bg-slate-50">
    <!-- Sidebar -->
    <aside class="@(isSidebarOpen ? "translate-x-0" : "-translate-x-full") lg:translate-x-0 fixed lg:static inset-y-0 left-0 z-50 flex-shrink-0 transition-transform duration-300 ease-in-out">
        <NavMenu OnToggleSidebar="ToggleSidebar" />
    </aside>

    <!-- Overlay -->
    @if (isSidebarOpen)
    {
        <div class="fixed inset-0 z-40 bg-black bg-opacity-50 lg:hidden" @onclick="ToggleSidebar"></div>
    }

    <!-- Main Content -->
    <div class="flex flex-col flex-1 min-w-0 overflow-hidden">
        <!-- Header -->
        <header class="flex items-center justify-between h-16 px-4 bg-white border-b border-slate-200 lg:px-8">
            <div class="flex items-center">
                <button class="mr-4 text-slate-500 lg:hidden hover:text-slate-600 focus:outline-none" @onclick="ToggleSidebar">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
                    </svg>
                </button>
                <h1 class="text-xl font-semibold text-slate-800">Arzly Admin</h1>
            </div>
            <div class="flex items-center space-x-4">
                <button class="p-1 text-slate-400 hover:text-slate-500">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                </button>
                <div class="w-8 h-8 rounded-full bg-slate-200"></div>
            </div>
        </header>

        <!-- Main Area -->
        <main class="flex-1 overflow-y-auto custom-scrollbar bg-slate-50 p-4 lg:p-8">
            <div class="max-w-7xl mx-auto">
                @Body
            </div>
        </main>
    </div>
</div>

@code {
    private bool isSidebarOpen = false;

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }
}
