@using Arzly.Shared.DTOs.Response.Listing
@using Arzly.Shared.DTOs.Request.Listing
@using Arzly.Shared.Enums.Listing
@inject IListingApiClient ListingApi
@inject Arzly.Client.Services.RightSliderService SliderService
@inject Arzly.Client.Services.ToastService ToastService

<div class="space-y-4 p-4">
    <div class="flex items-start gap-4">
        @if (!string.IsNullOrEmpty(Listing.PrimaryImageUrl))
        {
            <img src="@Listing.PrimaryImageUrl" class="w-20 h-20 rounded-lg object-cover" />
        }
        <div>
            <h2 class="text-lg font-semibold">@Listing.Title</h2>
            <p class="text-sm text-slate-500">@Listing.Description</p>
        </div>
    </div>

    <div>
        <label class="block text-sm mb-1">Status</label>
        <div class="relative inline-block text-left">
            <button class="inline-flex justify-between w-44 rounded-md border px-3 py-2 bg-surface text-on-surface" @onclick="ToggleDropdown">
                <span>@selectedStatus</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            @if (showOptions)
            {
                <div class="origin-top-right absolute right-0 mt-2 w-44 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-10">
                    <div class="py-1">
                        @foreach (var s in Enum.GetValues<ListingStatus>())
                        {
                            <button class="w-full text-left px-4 py-2 hover:bg-surface-container-low" @onclick="() => SelectStatus(s)">@s</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="pt-4">
        <button class="px-4 py-2 bg-primary text-white rounded-md shadow" disabled="@isSaving" @onclick="SaveAsync">
            @if (isSaving)
            {
                <span class="animate-spin inline-block h-4 w-4 border-b-2 border-white mr-2"></span>
                <span>Saving</span>
            }
            else
            {
                <span>Save</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public ListingResponse Listing { get; set; } = default!;
    [Parameter] public EventCallback<ListingResponse> OnSaved { get; set; }

    private ListingStatus selectedStatus;
    private bool showOptions = false;
    private bool isSaving = false;

    protected override void OnInitialized()
    {
        selectedStatus = Listing.Status;
    }

    private void ToggleDropdown() => showOptions = !showOptions;
    private void SelectStatus(ListingStatus s)
    {
        selectedStatus = s;
        showOptions = false;
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        StateHasChanged();

        var req = new ListingUpdateRequest
        {
            Id = Listing.Id,
            Title = Listing.Title,
            Description = Listing.Description,
            Price = Listing.Price,
            PrimaryImageUrl = Listing.PrimaryImageUrl,
            ImagesUrl = Listing.ImagesUrl,
            CategoryId = Listing.CategoryId,
            SubcategoryId = Listing.SubcategoryId,
            PickupLocationId = Listing.PickupLocationId,
            Name = Listing.Name,
            PhoneNumber = Listing.PhoneNumber,
            IsPriceNegotiable = Listing.IsPriceNegotiable,
            ContactMethod = Listing.ContactMethod,
            Status = selectedStatus
        };

        var res = await ListingApi.UpdateListingAsync(req);
        isSaving = false;

        if (res != null)
        {
            ToastService?.ShowSuccess("Listing updated");
            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync(res);
            }

            SliderService.Close();
        }
    }
}