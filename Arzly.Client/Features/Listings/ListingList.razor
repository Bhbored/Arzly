@inject IListingApiClient ListingApi

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="p-6 border-b border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <h2 class="text-lg font-bold text-slate-800">Listings</h2>
        <div class="relative max-w-sm w-full">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </span>
            <input type="text" 
                   class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary sm:text-sm" 
                   placeholder="Search listings..."
                   @bind="searchTerm" 
                   @bind:event="oninput" />
        </div>
    </div>
    
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold">
                <tr>
                    <th class="px-6 py-3 cursor-pointer" @onclick='() => Sort("Title")'>Title</th>
                    <th class="px-6 py-3 cursor-pointer" @onclick='() => Sort("Price")'>Price</th>
                    <th class="px-6 py-3">Status</th>
                    <th class="px-6 py-3 cursor-pointer" @onclick='() => Sort("CreatedAt")'>Created Date</th>
                    <th class="px-6 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (isLoading)
                {
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                            <div class="flex flex-col items-center">
                                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary mb-2"></div>
                                Loading listings...
                            </div>
                        </td>
                    </tr>
                }
                else if (!FilteredListings.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-400">No listings found matching your search.</td>
                    </tr>
                }
                else
                {
                    @foreach (var l in FilteredListings)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <div class="w-10 h-10 rounded-lg bg-slate-100 mr-3 flex-shrink-0"><img src="@l.PrimaryImageUrl" /></div>
                                    <div class="overflow-hidden">
                                        <p class="font-medium text-slate-800 truncate">@l.Title</p>
                                        <p class="text-xs text-slate-500 truncate">Category ID: @l.CategoryId</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-slate-700 font-medium">@l.Price.ToString("C")</td>
                            <td class="px-6 py-4">
                                <Badge Variant="@GetStatusVariant(l.Status)">
                                    @l.Status
                                </Badge>
                            </td>
                            <td class="px-6 py-4 text-slate-500 text-sm">@l.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="px-6 py-4 text-right">
                                <button class="text-slate-400 hover:text-primary">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<ListingResponse> listings = new();
    private string searchTerm = "";
    private bool isLoading = true;
    private string sortColumn = "CreatedAt";
    private bool sortAscending = false;

    private IEnumerable<ListingResponse> FilteredListings => listings
        .Where(l => string.IsNullOrWhiteSpace(searchTerm) || 
                    l.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(l => l.CreatedAt);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            listings = await ListingApi.GetAllListingsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string GetStatusVariant(ListingStatus status) => status switch
    {
        ListingStatus.Active => "success",
        ListingStatus.Pending => "pending",
        ListingStatus.Sold => "sold",
        ListingStatus.Deleted => "neutral",
        _ => "neutral"
    };
}
