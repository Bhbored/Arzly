@inject IListingApiClient ListingApi
@inject IJobListingApiClient JobApi
@inject ICategoryApiClient CategoryApi
@inject IReportApiClient ReportApi

<div>
    <div class="mb-8 flex justify-between items-end">
        <div>
            <h2 class="font-headline-xl text-headline-xl text-on-surface mb-2">Dashboard Overview</h2>
            <p class="text-stone font-body-md text-body-md">Platform metrics and recent activity across Arzly.</p>
        </div>
        <div class="flex gap-3">
            <button class="px-4 py-2 bg-surface border border-outline-variant rounded-lg text-primary font-body-md text-body-md flex items-center gap-2 hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined text-[20px]">download</span>
                Export Report
            </button>
        </div>
    </div>

    <!-- KPI Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-surface rounded-xl p-5 cedar-shadow border border-outline-variant/30 flex flex-col justify-between">
            <div class="flex justify-between items-start mb-4">
                <div class="w-10 h-10 rounded-lg bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">list_alt</span>
                </div>
                <span class="text-forest font-data-mono text-data-mono flex items-center gap-1">+12% <span class="material-symbols-outlined text-[14px]">trending_up</span></span>
            </div>
            <div>
                <p class="text-stone font-body-sm text-body-sm mb-1">Total Listings</p>
                <p class="font-headline-md text-headline-md text-on-surface">@totalListings</p>
            </div>
        </div>

        <div class="bg-surface rounded-xl p-5 cedar-shadow border border-outline-variant/30 flex flex-col justify-between">
            <div class="flex justify-between items-start mb-4">
                <div class="w-10 h-10 rounded-lg bg-primary-container/10 flex items-center justify-center text-primary-container">
                    <span class="material-symbols-outlined">check_circle</span>
                </div>
                <span class="text-forest font-data-mono text-data-mono flex items-center gap-1">+5% <span class="material-symbols-outlined text-[14px]">trending_up</span></span>
            </div>
            <div>
                <p class="text-stone font-body-sm text-body-sm mb-1">Active Listings</p>
                <p class="font-headline-md text-headline-md text-on-surface">@totalJobs</p>
            </div>
        </div>

        <div class="bg-surface rounded-xl p-5 cedar-shadow border border-outline-variant/30 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute top-0 right-0 w-16 h-16 bg-harvest/10 rounded-bl-full -z-10"></div>
            <div class="flex justify-between items-start mb-4">
                <div class="w-10 h-10 rounded-lg bg-secondary-container/30 flex items-center justify-center text-harvest">
                    <span class="material-symbols-outlined">pending_actions</span>
                </div>
                <span class="bg-harvest text-on-secondary px-2 py-0.5 rounded-full font-label-caps text-label-caps">124 REQ</span>
            </div>
            <div>
                <p class="text-stone font-body-sm text-body-sm mb-1">Pending Listings</p>
                <p class="font-headline-md text-headline-md text-on-surface">432</p>
            </div>
        </div>

        <div class="bg-surface rounded-xl p-5 cedar-shadow border border-outline-variant/30 flex flex-col justify-between">
            <div class="flex justify-between items-start mb-4">
                <div class="w-10 h-10 rounded-lg bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">work</span>
                </div>
            </div>
            <div>
                <p class="text-stone font-body-sm text-body-sm mb-1">Total Job Listings</p>
                <p class="font-headline-md text-headline-md text-on-surface">@totalJobs</p>
            </div>
        </div>        <!-- Second row of small KPIs -->
        <div class="bg-surface rounded-xl p-5 cedar-shadow border border-outline-variant/30 flex flex-col justify-between">
            <div class="flex justify-between items-start mb-4">
                <div class="w-10 h-10 rounded-lg bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">group</span>
                </div>
            </div>
            <div>
                <p class="text-stone font-body-sm text-body-sm mb-1">Active Users</p>
                <p class="font-headline-md text-headline-md text-on-surface">8,540</p>
            </div>
        </div>        <div class="bg-surface rounded-xl p-5 cedar-shadow border border-bark-red/20 flex flex-col justify-between">
            <div class="flex justify-between items-start mb-4">
                <div class="w-10 h-10 rounded-lg bg-error-container flex items-center justify-center text-error">
                    <span class="material-symbols-outlined">confirmation_number</span>
                </div>
                <span class="text-bark-red font-data-mono text-data-mono flex items-center gap-1">+2 <span class="material-symbols-outlined text-[14px]">trending_up</span></span>
            </div>
            <div>
                <p class="text-stone font-body-sm text-body-sm mb-1">Open Tickets</p>
                <p class="font-headline-md text-headline-md text-bark-red">14</p>
            </div>
        </div>        <div class="bg-surface rounded-xl p-5 cedar-shadow border border-bark-red/20 flex flex-col justify-between">
            <div class="flex justify-between items-start mb-4">
                <div class="w-10 h-10 rounded-lg bg-error-container flex items-center justify-center text-error">
                    <span class="material-symbols-outlined">report</span>
                </div>
            </div>
            <div>
                <p class="text-stone font-body-sm text-body-sm mb-1">Pending Reports</p>
                <p class="font-headline-md text-headline-md text-bark-red">@pendingReports</p>
            </div>
        </div>        <div class="bg-surface rounded-xl p-5 cedar-shadow border border-outline-variant/30 flex flex-col justify-between">
            <div class="flex justify-between items-start mb-4">
                <div class="w-10 h-10 rounded-lg bg-surface-container-low flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">chat</span>
                </div>
            </div>
            <div>
                <p class="text-stone font-body-sm text-body-sm mb-1">Today's Chats</p>
                <p class="font-headline-md text-headline-md text-on-surface">1,204</p>
            </div>
        </div>
    </div>

    <!-- Recent Listings table -->
    <div class="bg-surface rounded-xl cedar-shadow border border-outline-variant overflow-hidden">
        <div class="p-6 border-b border-outline-variant flex justify-between items-center">
            <h2 class="text-lg font-bold text-on-surface">Recent Listings</h2>
            <a href="listings" class="text-primary text-sm font-medium hover:underline">View All</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-surface-container-low border-b border-outline-variant text-xs uppercase text-stone font-semibold">
                    <tr>
                        <th class="px-6 py-3">Listing</th>
                        <th class="px-6 py-3">Price</th>
                        <th class="px-6 py-3">Status</th>
                        <th class="px-6 py-3">Created</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-variant">
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-stone">Loading...</td>
                        </tr>
                    }
                    else if (!recentListings.Any())
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-stone">No listings found</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var l in recentListings)
                        {
                            <tr>
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <div class="w-10 h-10 rounded bg-surface-container-low mr-3"></div>
                                        <span class="font-medium text-on-surface">@l.Title</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-on-surface-variant">@l.Price.ToString("C")</td>
                                <td class="px-6 py-4">
                                    <Badge Variant="@GetStatusVariant(l.Status)">@l.Status</Badge>
                                </td>
                                <td class="px-6 py-4 text-stone text-sm">@l.CreatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<ListingResponse> recentListings = new();
    private int totalListings = 0;
    private int totalJobs = 0;
    private int totalCategories = 0;
    private int pendingReports = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var listingsTask = ListingApi.GetAllListingsAsync();
            var jobsTask = JobApi.GetAllJobListingsAsync();
            var catsTask = CategoryApi.GetAllCategoriesAsync();
            var reportsTask = ReportApi.GetAllReportsAsync();

            await Task.WhenAll(listingsTask, jobsTask, catsTask, reportsTask);

            var listings = listingsTask.Result;
            totalListings = listings.Count;
            recentListings = listings.Take(10).ToList();

            totalJobs = jobsTask.Result.Count;
            totalCategories = catsTask.Result.Count;
            pendingReports = reportsTask.Result.Count(r => !r.IsResolved);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusVariant(ListingStatus status) => status switch
    {
        ListingStatus.Active => "success",
        ListingStatus.Pending => "pending",
        ListingStatus.Sold => "sold",
        ListingStatus.Deleted => "neutral",
        _ => "neutral"
    };
}

