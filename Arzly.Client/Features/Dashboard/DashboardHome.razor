@inject IListingApiClient ListingApi
@inject IJobListingApiClient JobApi
@inject ICategoryApiClient CategoryApi
@inject IReportApiClient ReportApi

<div class="space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <StatCard Label="Total Listings" Value="@totalListings.ToString()" IconContainerClass="bg-blue-50 text-blue-600">
            <Icon>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
            </Icon>
        </StatCard>
        
        <StatCard Label="Job Listings" Value="@totalJobs.ToString()" IconContainerClass="bg-green-50 text-green-600">
            <Icon>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </Icon>
        </StatCard>

        <StatCard Label="Categories" Value="@totalCategories.ToString()" IconContainerClass="bg-purple-50 text-purple-600">
            <Icon>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                </svg>
            </Icon>
        </StatCard>

        <StatCard Label="Pending Reports" Value="@pendingReports.ToString()" IconContainerClass="bg-red-50 text-red-600">
            <Icon>
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </Icon>
        </StatCard>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 border-b border-slate-200 flex justify-between items-center">
            <h2 class="text-lg font-bold text-slate-800">Recent Listings</h2>
            <a href="listings" class="text-primary text-sm font-medium hover:underline">View All</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold">
                    <tr>
                        <th class="px-6 py-3">Listing</th>
                        <th class="px-6 py-3">Price</th>
                        <th class="px-6 py-3">Status</th>
                        <th class="px-6 py-3">Created</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-slate-400">Loading...</td>
                        </tr>
                    }
                    else if (!recentListings.Any())
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-slate-400">No listings found</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var l in recentListings)
                        {
                            <tr>
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <div class="w-10 h-10 rounded bg-slate-100 mr-3"></div>
                                        <span class="font-medium text-slate-700">@l.Title</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-600">@l.Price.ToString("C")</td>
                                <td class="px-6 py-4">
                                    <Badge Class="@GetStatusClass(l.Status)">
                                        @l.Status
                                    </Badge>
                                </td>
                                <td class="px-6 py-4 text-slate-500 text-sm">@l.CreatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<ListingResponse> recentListings = new();
    private int totalListings = 0;
    private int totalJobs = 0;
    private int totalCategories = 0;
    private int pendingReports = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var listingsTask = ListingApi.GetAllListingsAsync();
            var jobsTask = JobApi.GetAllJobListingsAsync();
            var catsTask = CategoryApi.GetAllCategoriesAsync();
            var reportsTask = ReportApi.GetAllReportsAsync();

            await Task.WhenAll(listingsTask, jobsTask, catsTask, reportsTask);

            var listings = listingsTask.Result;
            totalListings = listings.Count;
            recentListings = listings.Take(10).ToList();

            totalJobs = jobsTask.Result.Count;
            totalCategories = catsTask.Result.Count;
            pendingReports = reportsTask.Result.Count(r => !r.IsResolved);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusClass(ListingStatus status) => status switch
    {
        ListingStatus.Active => "bg-green-100 text-green-700",
        ListingStatus.Pending => "bg-amber-100 text-amber-700",
        ListingStatus.Sold => "bg-blue-100 text-blue-700",
        ListingStatus.Deleted => "bg-slate-100 text-slate-700",
        _ => "bg-slate-100 text-slate-700"
    };
}
